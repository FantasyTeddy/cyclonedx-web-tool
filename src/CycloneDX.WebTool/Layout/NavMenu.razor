<div class="nav-inner">
    <a href="" class="nav-brand">
        <img src="cyclonedx-logo.svg" alt="CycloneDX Logo" height="24" />
        <span class="nav-brand-sep">/</span>
        <span class="nav-brand-tool">Web Tool</span>
    </a>

    <nav class="@NavLinksClass">
        <NavLink class="nav-link" href="convert"><span class="oi oi-transfer" aria-hidden="true"></span> Convert</NavLink>
        <NavLink class="nav-link" href="validate"><span class="oi oi-check" aria-hidden="true"></span> Validate</NavLink>
        <NavLink class="nav-link" href="merge"><span class="oi oi-fullscreen-exit" aria-hidden="true"></span> Merge</NavLink>
    </nav>

    <button class="nav-toggle" title="Navigation menu" @onclick="ToggleMenu">
        <span class="oi oi-menu" aria-hidden="true"></span>
