@page "/merge"
@using System.IO
@using System.Text
@using Microsoft.AspNetCore.Components.Forms
@using CycloneDX.Models
@using CycloneDX.Xml
@using CycloneDX.Json

@inject IJSRuntime _jsRuntime;

<div class="tool-header">
    <h1>Merge</h1>
    <p>Combine multiple CycloneDX BOMs into a single unified BOM using a flat merge.</p>
</div>

<div class="tool-card">
    <form>
        <div class="mb-3">
            <label class="form-label" for="inputFiles">Input Files</label>
            <InputFile multiple id="inputFiles" class="form-control" OnChange="@LoadInputFiles" />
        </div>

        <div class="mb-3">
            <label class="form-label" for="inputFormat">Input Format</label>
            <select id="inputFormat" class="form-select" @bind="_inputFormat">
                <option value="autodetect">Autodetect</option>
                <option value="json">JSON</option>
                <option value="xml">XML</option>
                <option value="bin">Protobuf</option>
            </select>
        </div>

        <div class="form-row mb-4">
            <div>
                <label class="form-label" for="outputFormat">Output Format</label>
                <select id="outputFormat" class="form-select" @bind="_outputFormat">
                    <option value="json">JSON</option>
                    <option value="xml">XML</option>
                    <option value="bin">Protobuf</option>
                </select>
            </div>
            <div>
                <label class="form-label" for="outputVersion">Version</label>
                <select id="outputVersion" class="form-select" @bind="_outputVersion">
                    <option value="v1_7">v1.7</option>
                    <option value="v1_6">v1.6</option>
                    <option value="v1_5">v1.5</option>
                    <option value="v1_4">v1.4</option>
                    <option value="v1_3">v1.3</option>
                    <option value="v1_2">v1.2</option>
                    <option value="v1_1">v1.1</option>
                    <option value="v1_0">v1.0</option>
                </select>
            </div>
        </div>

        <button id="merge" type="button" class="btn btn-primary" @onclick="@MergeBOM" hidden="@(_inputFileContents == null)">
            Merge &amp; Download
        </button>
    </form>

    @if (_statusMessage != null)
    {
        <div class="status-alert @_statusClass">
            @_statusMessage
        </div>
    }
</div>

@code {
    private List<byte[]>? _inputFileContents;
    private List<string>? _userInputFilenames;
    private string _inputFormat = "autodetect";
    private string _outputFormat = "json";
    private string _outputVersion = "v1_7";
    private string? _statusMessage;
    private string _statusClass = "status-error";

    private void ShowError(string message)
    {
        _statusMessage = message;
        _statusClass = "status-error";
    }

    private void ShowSuccess(string message)
    {
        _statusMessage = message;
        _statusClass = "status-success";
    }

    private async Task LoadInputFiles(InputFileChangeEventArgs e)
    {
        _statusMessage = null;
        if (e.FileCount > 0)
        {
            _inputFileContents = new List<byte[]>();
            _userInputFilenames = new List<string>();
            foreach (var file in e.GetMultipleFiles())
            {
                using (var ms = new MemoryStream())
                {
                    await file.OpenReadStream(102400000).CopyToAsync(ms);
                    _inputFileContents.Add(ms.ToArray());
                }
                _userInputFilenames.Add(file.Name);
            }
        }
        else
        {
            _inputFileContents = null;
            _userInputFilenames = null;
        }
    }

    private async Task MergeBOM()
    {
        _statusMessage = null;

        if (_userInputFilenames is null || _inputFileContents is null)
        {
            ShowError("Invalid state. Filename or file content cannot be null.");
            return;
        }

        if (!Enum.TryParse(_outputVersion, out SpecificationVersion specificationVersion))
        {
            ShowError("Looks like you've hit a bug — there has been a problem reading the schema version.");
            return;
        }

        Models.Bom? mergedBom = null;
        for (var i = 0; i < _inputFileContents.Count; i++)
        {
            var fileContents = _inputFileContents[i];
            var filename = _userInputFilenames[i];
            Models.Bom? currentBom = null;

            if (_inputFormat == "json" || _inputFormat == "autodetect" && filename.EndsWith(".json"))
            {
                try
                {
                    currentBom = Json.Serializer.Deserialize(Encoding.UTF8.GetString(fileContents));
                }
                catch (Exception e)
                {
                    ShowError($"Error deserializing \"{filename}\": " + e.Message);
                    return;
                }
            }
            else if (_inputFormat == "xml" || _inputFormat == "autodetect" && filename.EndsWith(".xml"))
            {
                try
                {
                    currentBom = Xml.Serializer.Deserialize(Encoding.UTF8.GetString(fileContents));
                }
                catch (Exception e)
                {
                    ShowError($"Error deserializing \"{filename}\": " + e.Message);
                    return;
                }
            }
            else if (_inputFormat == "bin" || _inputFormat == "autodetect" && filename.EndsWith(".bin"))
            {
                try
                {
                    currentBom = Protobuf.Serializer.Deserialize(fileContents);
                }
                catch (Exception e)
                {
                    ShowError($"Error deserializing \"{filename}\": " + e.Message);
                    return;
                }
            }
            else
            {
                ShowError($"Unable to auto-detect format for \"{filename}\". Please specify the format explicitly.");
                return;
            }

            if (mergedBom == null)
            {
                mergedBom = currentBom;
            }
            else
            {
                mergedBom = CycloneDXUtils.FlatMerge(mergedBom, currentBom);
            }
        }

        if (mergedBom is null)
        {
            ShowError("Invalid state. Merged BOM cannot be null.");
            return;
        }

        mergedBom.SpecVersion = specificationVersion;

        byte[] output;

        if (_outputFormat == "json")
        {
            if (mergedBom.SpecVersion < SpecificationVersion.v1_2)
            {
                ShowError("JSON output is only supported for specification versions 1.2 and above.");
                return;
            }
            else
            {
                output = Encoding.UTF8.GetBytes(Json.Serializer.Serialize(mergedBom));
            }
        }
        else if (_outputFormat == "bin")
        {
            if (mergedBom.SpecVersion < SpecificationVersion.v1_3)
            {
                ShowError("Protobuf output is only supported for specification versions 1.3 and above.");
                return;
            }
            else
            {
                output = Protobuf.Serializer.Serialize(mergedBom);
            }
        }
        else
        {
            output = Encoding.UTF8.GetBytes(Xml.Serializer.Serialize(mergedBom));
        }

        var outputBom64 = System.Convert.ToBase64String(output);
        await _jsRuntime.InvokeVoidAsync("cdxFileDownload", "merged-bom." + _outputFormat, outputBom64);
        ShowSuccess($"Merged {_inputFileContents.Count} BOMs successfully — your download should begin shortly.");
    }
}
