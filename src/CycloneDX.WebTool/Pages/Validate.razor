@page "/validate"
@using System.IO
@using System.Text
@using Microsoft.AspNetCore.Components.Forms
@using CycloneDX.Models
@using CycloneDX.Xml
@using CycloneDX.Json

@inject IJSRuntime _jsRuntime;

<div class="tool-header">
    <h1>Validate</h1>
    <p>Check whether a CycloneDX BOM conforms to the selected specification version schema.</p>
</div>

<div class="tool-card">
    <form>
        <div class="mb-3">
            <label class="form-label" for="inputFile">BOM File</label>
            <InputFile id="inputFile" class="form-control" OnChange="@LoadInputFile" />
        </div>

        <div class="form-row mb-4">
            <div>
                <label class="form-label" for="inputFormat">Format</label>
                <select id="inputFormat" class="form-select" @bind="_inputFormat">
                    <option value="autodetect">Autodetect</option>
                    <option value="json">JSON</option>
                    <option value="xml">XML</option>
                </select>
            </div>
            <div>
                <label class="form-label" for="inputVersion">Specification Version</label>
                <select id="inputVersion" class="form-select" @bind="_inputVersion">
                    <option value="v1_7">v1.7</option>
                    <option value="v1_6">v1.6</option>
                    <option value="v1_5">v1.5</option>
                    <option value="v1_4">v1.4</option>
                    <option value="v1_3">v1.3</option>
                    <option value="v1_2">v1.2</option>
                    <option value="v1_1">v1.1</option>
                    <option value="v1_0">v1.0</option>
                </select>
            </div>
        </div>

        <button id="validate" type="button" class="btn btn-primary" @onclick="@ValidateBOM" hidden="@(_inputFileContents == null)">
            Validate
        </button>
    </form>

    @if (_statusMessage != null)
    {
        <div class="status-alert @_statusClass">
            <div>
                <div>@_statusMessage</div>
                @if (_validationErrors.Count > 0)
                {
                    <ul class="validation-errors">
                        @foreach (var msg in _validationErrors)
                        {
                            <li>@msg</li>
                        }
                    </ul>
                }
            </div>
        </div>
    }
</div>

@code {
    private string? _inputFileContents;
    private string? _userInputFilename;
    private string _inputFormat = "autodetect";
    private string _inputVersion = "v1_7";
    private string? _statusMessage;
    private string _statusClass = "status-error";
    private List<string> _validationErrors = new();

    private void ShowError(string message)
    {
        _statusMessage = message;
        _statusClass = "status-error";
    }

    private void ShowSuccess(string message)
    {
        _statusMessage = message;
        _statusClass = "status-success";
    }

    private async Task LoadInputFile(InputFileChangeEventArgs e)
    {
        _statusMessage = null;
        _validationErrors.Clear();
        if (e.FileCount == 1)
        {
            using (var sr = new StreamReader(e.File.OpenReadStream(102400000)))
            {
                _inputFileContents = await sr.ReadToEndAsync();
            }
            _userInputFilename = e.File.Name;
        }
        else
        {
            _inputFileContents = null;
            _userInputFilename = null;
        }
    }

    private void ValidateBOM()
    {
        _statusMessage = null;
        _validationErrors.Clear();

        if (_userInputFilename is null || _inputFileContents is null)
        {
            ShowError("Invalid state. Filename or file content cannot be null.");
            return;
        }

        if (!Enum.TryParse(_inputVersion, out SpecificationVersion specificationVersion))
        {
            ShowError("Looks like you've hit a bug — there has been a problem reading the schema version.");
            return;
        }

        ValidationResult result;

        if (_inputFormat == "json" || _inputFormat == "autodetect" && _userInputFilename.EndsWith(".json"))
        {
            try
            {
                result = Json.Validator.Validate(_inputFileContents, specificationVersion);
            }
            catch (Exception e)
            {
                ShowError("Error validating BOM: " + e.Message);
                return;
            }
        }
        else if (_inputFormat == "xml" || _inputFormat == "autodetect" && _userInputFilename.EndsWith(".xml"))
        {
            try
            {
                result = Xml.Validator.Validate(_inputFileContents, specificationVersion);
            }
            catch (Exception e)
            {
                ShowError("Error validating BOM: " + e.Message);
                return;
            }
        }
        else
        {
            ShowError("Unable to auto-detect input format. Please specify the format explicitly.");
            return;
        }

        var versionLabel = _inputVersion.Replace('_', '.');

        if (result.Valid)
        {
            ShowSuccess($"Valid — this file is a conformant {versionLabel} BOM.");
        }
        else
        {
            ShowError($"Invalid — this file does not conform to the {versionLabel} schema:");
            _validationErrors = result.Messages?.ToList() ?? new List<string>();
        }
    }
}
